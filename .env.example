# Copy this file to .env and fill in real values.
# Never commit the populated .env file — it is gitignored by default.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=changeme

# ---- Mail (OTP delivery) ----
# Use a Gmail App Password, not your regular account password:
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_APP_PASSWORD=your-16-character-app-password

# ---- AWS / S3 ----
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-north-1
S3_BUCKET_NAME=zetflix-movies

# ---- JWT ----
JWT_SECRET=replace-with-a-long-random-string

# ---- ECR (used during deployment, not by the app services directly) ----
ECR_REGISTRY=your-account-id.dkr.ecr.eu-north-1.amazonaws.com
